<section class="netex">
  <div class="container">
    <div class="validation-title">
      <.netex_validation_report_title
        validation_report_url={@report.download_url}
        heading_level={2}
      />

      <p>
        {dgettext("validations", "explanations-netex")}
      </p>
      <p>
        {dgettext("validations", "This report can be shared with")}
        <.link href={current_url(@conn)}>{dgettext("validations", "this permanent link")}</.link>
        {dgettext("validations", "during %{retention_days} days", retention_days: @report.retention_days)}.
      </p>
    </div>

    <%= unless is_nil(@report.metadata) or @report.metadata == %{} do %>
      {render("_resources_details_netex.html", metadata: @report.metadata, conn: @conn)}
    <% end %>
  </div>

  <div id="validation-report" class="validation-content">
    <div id="issues" class="container">
      <.netex_validation_report title={false} report={@report} conn={@conn} heading_level={2} />
    </div>
  </div>
</section>

<section class="section section-white">
  {live_render(@conn, TransportWeb.Live.FeedbackLive, session: %{"feature" => "on_demand_validation"})}
</section>
