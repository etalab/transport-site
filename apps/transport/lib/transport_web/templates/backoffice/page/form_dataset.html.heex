<div class="pt-48">
  {live_render(@conn, TransportWeb.EditDatasetLive,
    session: %{
      "dataset" => @dataset,
      "dataset_types" => @dataset_types,
      "regions" => @regions,
      "csp_nonce_value" => Plug.Conn.get_session(@conn, :nonce)
    }
  )}

  <%= unless is_nil(@dataset) do %>
    <div class="is-centered mt-48">
      {dgettext("backoffice", "Other actions on the dataset")}
    </div>
    <div class="backoffice_dataset_actions_buttons">
      <div>
        <.form
          for={%{}}
          action={
            backoffice_dataset_path(
              @conn,
              :import_from_data_gouv_fr,
              @dataset.id,
              Map.put(@conn.params, "stay_on_page", true)
            )
          }
        >
          <.button>Importer</.button>
        </.form>
      </div>

      <div>
        {live_render(@conn, TransportWeb.Live.ValidateDatasetView,
          session: %{"dataset_id" => @dataset.id, "base_classname" => "button"}
        )}
      </div>

      <div>
        <.form for={%{}} action={backoffice_dataset_path(@conn, :delete, @dataset.id, @conn.params)}>
          <.button>Déréférencer</.button>
        </.form>
      </div>
    </div>

    <div id="resource_historization" class="dashboard-description mt-48">
      <h3>{dgettext("backoffice", "Resource historization")}</h3>

      <%= if Dataset.should_skip_history?(@dataset) do %>
        <p class="notification">
          {dgettext("backoffice", "This dataset is not historicized on purpose.")}
        </p>
      <% else %>
        <% nb_resources = length(@resources_with_history) %>
        {dngettext(
          "backoffice",
          "There is %{n} resource in this dataset",
          "There are %{n} resources in this dataset",
          nb_resources,
          n: Helpers.format_number(nb_resources, locale: get_session(@conn, :locale))
        )}

        <%= if nb_resources > 0 do %>
          <table class="table">
            <tr>
              <th>{dgettext("backoffice", "Resource")}</th>
              <th>{dgettext("backoffice", "Last historization")}</th>
            </tr>
            <%= for r <- @resources_with_history do %>
              <tr>
                <td><.link href={resource_path(@conn, :details, r.id)}>{r.title}</.link></td>
                <td>
                  <%= if r.resource_history == [] do %>
                    🚫
                  <% else %>
                    {r.resource_history |> Enum.at(0) |> Map.get(:inserted_at)}
                  <% end %>
                </td>
              </tr>
            <% end %>
          </table>
        <% end %>
      <% end %>
    </div>

    <div id="resource_format_override" class="dashboard-description mt-48">
      <h3>Format d'une ressource</h3>
      <p>
        Vous pouvez forcer le format d'une ressource en utilisant ce formulaire.
      </p>
      <.form :let={f} for={@conn.params} action={backoffice_dataset_path(@conn, :resource_format_override, @dataset.id)}>
        <.input
          field={f[:resource_id]}
          type="select"
          options={Enum.map(@resources, &[key: "#{&1.title} - #{&1.format}", value: &1.id])}
        />
        <.input field={f[:format_override]} type="select" options={@resource_formats} />
        <div class="form__group"><.button>Changer le format</.button></div>
      </.form>
    </div>

    <div id="resource_related" class="dashboard-description mt-48">
      <h3>Associer 2 ressources</h3>
      <p>
        Vous pouvez associer manuellement deux ressources de ce jeu de données.
      </p>
      <%= if Enum.count(@resource_related) > 0 do %>
        <table class="table mb-24">
          <tr>
            <th>Ressource de référence</th>
            <th>Ressource complémentaire</th>
            <th>Motif</th>
            <th>Actions</th>
          </tr>
          <%= for rr <- @resource_related do %>
            <tr>
              <td>
                <.link href={resource_path(@conn, :details, rr.resource_src_id)}>{rr.resource_src.title}</.link>
                <span class="label">{rr.resource_src.format}</span>
              </td>
              <td>
                <.link href={resource_path(@conn, :details, rr.resource_dst_id)}>{rr.resource_dst.title}</.link>
                <span class="label">{rr.resource_dst.format}</span>
              </td>
              <td>{DB.ResourceRelated.reason_to_str(rr)}</td>
              <td>
                <.form
                  :let={f}
                  for={@conn.params}
                  action={backoffice_dataset_path(@conn, :resource_related_delete, @dataset.id)}
                >
                  <.input field={f[:resource_src_id]} type="hidden" value={rr.resource_src_id} />
                  <.input field={f[:resource_dst_id]} type="hidden" value={rr.resource_dst_id} />
                  <.input field={f[:reason]} type="hidden" value={rr.reason} />
                  <button class="small button-outline no-border warning">
                    <i class="fas fa-trash"></i>
                  </button>
                </.form>
              </td>
            </tr>
          <% end %>
        </table>
      <% end %>
      <.form :let={f} for={@conn.params} action={backoffice_dataset_path(@conn, :resource_related_create, @dataset.id)}>
        <label for={f[:resource_src_id].id}>Ressource de référence</label>
        <.input
          field={f[:resource_src_id]}
          type="select"
          options={Enum.map(@resources, &[key: "#{&1.title} - #{&1.format}", value: &1.id])}
        />
        <label for={f[:resource_dst_id].id}>Ressource complémentaire</label>
        <.input
          field={f[:resource_dst_id]}
          type="select"
          options={Enum.map(@resources, &[key: "#{&1.title} - #{&1.format}", value: &1.id])}
        />
        <label for={f[:reason].id}>Motif</label>
        <.input
          field={f[:reason]}
          type="select"
          options={
            Enum.map(
              Ecto.Enum.values(DB.ResourceRelated, :reason),
              &[key: DB.ResourceRelated.reason_to_str(%DB.ResourceRelated{reason: &1}), value: &1]
            )
          }
        />
        <div class="form__group"><.button>Associer</.button></div>
      </.form>
    </div>

    <div id="notification_subscriptions" class="dashboard-description mt-48">
      <h3>Abonnements aux notifications des producteurs</h3>

      <h4>Créer un abonnement</h4>
      <.form :let={f} for={@conn.params} action={backoffice_notification_subscription_path(@conn, :create)}>
        <.input field={f[:redirect_location]} type="hidden" value="dataset" />
        <.input field={f[:dataset_id]} type="hidden" value={@dataset.id} />
        <label for={f[:contact_id].id}>
          Contact <.input field={f[:contact_id]} required list="contacts_datalist" pattern="[0-9]+" />
          <div class="small">
            <a href={backoffice_contact_path(@conn, :new)} target="_blank">
              <i class="fas fa-arrow-up-right-from-square"></i> Créer un contact
            </a>
          </div>
          <div :if={Enum.count(@contacts_in_org) > 0}>
            <p>
              Producteurs s’étant déjà connectés au PAN
            </p>
            <ul>
              <%= for contact <- @contacts_in_org do %>
                <% onclick_fn = ~s{getElementById("contact_id").value =} <> to_string(contact.id) %>
                <li class="pb-6">
                  <a href={backoffice_contact_path(@conn, :edit, contact.id)} target="_blank">
                    <i class="fas fa-arrow-up-right-from-square"></i> {DB.Contact.display_name(contact)}
                  </a>
                  <span class="small">{"(##{contact.id})"}</span>
                  <button type="button" class="button-outline small primary" onclick={onclick_fn}>Sélectionner</button>
                </li>
              <% end %>
            </ul>
          </div>
        </label>
        <datalist id="contacts_datalist">
          <%= for contact <- @contacts_datalist do %>
            <% display_name = DB.Contact.display_name(contact) %>
            <% unaccent_display_name = unaccent(display_name) %>
            <option value={contact.id}>{display_name} ({contact.organization})</option>
            <option :if={display_name != unaccent_display_name} value={contact.id}>
              {unaccent_display_name} ({contact.organization})
            </option>
          <% end %>
        </datalist>
        <label for={f[:reasons].id} class="pt-12">
          {dgettext("backoffice", "Notification reason")}
          <%= for reason <- Transport.NotificationReason.subscribable_reasons_related_to_datasets(:producer) do %>
            <label for={f[reason].id}>
              <input type="checkbox" id={f[reason].id} name={f[reason].name} value="true" checked />
              {reason}
            </label>
          <% end %>
        </label>

        <div class="form__group"><.button>Créer un abonnement</.button></div>
      </.form>
      <h4 id="existing_subscriptions">{dgettext("backoffice", "Existing subscriptions")}</h4>
      <table :if={Enum.count(@dataset.notification_subscriptions) > 0} id="existing_subscriptions_table" class="table">
        <tr>
          <th>Contact</th>
          <th>{dgettext("backoffice", "Notification reason")}</th>
          <th>Source</th>
          <th>Actions</th>
        </tr>
        <%= for {contact, notification_subscriptions} <- @subscriptions_by_producer do %>
          <%= for {notification_subscription, index} <- Enum.with_index(notification_subscriptions) do %>
            <tr>
              <td :if={index == 0} rowspan={Enum.count(notification_subscriptions)}>
                <a href={backoffice_contact_path(@conn, :edit, contact.id)}>
                  {notification_subscription_contact(notification_subscription)}
                </a>

                <div class="inline-block">
                  <.form
                    :let={f}
                    for={@conn.params}
                    action={
                      backoffice_notification_subscription_path(
                        @conn,
                        :delete_for_contact_and_dataset,
                        contact.id,
                        @dataset.id
                      )
                    }
                    method="delete"
                  >
                    <.input field={f[:redirect_location]} type="hidden" value="dataset" />
                    <button class="small button-outline no-border warning" title="désabonner entièrement">
                      <i class="fa-solid fa-xmark"></i>
                    </button>
                  </.form>
                </div>
              </td>
              <td>{notification_subscription.reason}</td>
              <td>{notification_subscription.source}</td>
              <td>
                <.form
                  :let={f}
                  for={@conn.params}
                  action={backoffice_notification_subscription_path(@conn, :delete, notification_subscription.id)}
                  method="delete"
                >
                  <.input field={f[:redirect_location]} type="hidden" value="dataset" />
                  <button class="small button-outline no-border warning">
                    <i class="fas fa-trash"></i>
                  </button>
                </.form>
              </td>
            </tr>
          <% end %>
        <% end %>
      </table>
      <p :if={Enum.count(@dataset.notification_subscriptions) > 0} class="small">
        Cette liste ne concerne que les producteurs.
      </p>
      <p :if={@reusers_count > 0} id="reuser_subscriptions">
        {dngettext(
          "backoffice",
          "reuser-subscription-count",
          "reuser-subscriptions-count",
          @reuser_subscriptions_count,
          reuser_subscriptions_count:
            Helpers.format_number(@reuser_subscriptions_count, locale: get_session(@conn, :locale))
        )}
        {dngettext(
          "backoffice",
          "reuser-count",
          "reusers-count",
          @reusers_count,
          reusers_count: Helpers.format_number(@reusers_count, locale: get_session(@conn, :locale))
        )}
      </p>
      <p :if={Enum.empty?(@dataset.notification_subscriptions)} class="mt-48 notification">
        {dgettext("backoffice", "There are no notification subscriptions for this contact.")}
      </p>
      <div :if={Enum.count(@dataset.notification_subscriptions) > 0}>
        {live_render(@conn, TransportWeb.Live.SendNowOnNAPNotificationView,
          session: %{
            "dataset_id" => @dataset.id,
            "sent_reasons" =>
              @notifications_sent |> Enum.map(fn {{reason, _datetime}, _emails} -> reason end) |> Enum.uniq()
          }
        )}
      </div>
    </div>
    <div :if={Enum.count(@notifications_sent) > 0} id="notifications_sent" class="dashboard-description mt-48">
      <h3>{dgettext("backoffice", "Notifications sent")}</h3>

      <p>
        {dgettext("backoffice", "Notifications sent in the last %{nb_days} days.", nb_days: @notifications_last_nb_days)}
      </p>
      <table class="table">
        <tr>
          <th>{dgettext("backoffice", "Notification reason")}</th>
          <th>{dgettext("backoffice", "Datetime")}</th>
          <th>{dgettext("backoffice", "Emails")}</th>
        </tr>
        <%= for {{reason, datetime}, emails} <- @notifications_sent do %>
          <tr>
            <td lang="en">{reason}</td>
            <td>{Shared.DateTimeDisplay.format_datetime_to_paris(datetime, "fr")}</td>
            <td>{emails |> Enum.sort() |> Enum.join(", ")}</td>
          </tr>
        <% end %>
      </table>
    </div>
    <div class="dataset_import_validations_logs" id="imports_history">
      <h3>{dgettext("backoffice", "Imports history")}</h3>
      <table>
        <tr>
          <th>{dgettext("backoffice", "date / time")}</th>
          <th>{dgettext("backoffice", "success")}</th>
          <th>{dgettext("backoffice", "error message")}</th>
        </tr>
        <%= for row <- @import_logs do %>
          <tr>
            <td>{row.timestamp}</td>
            <td>{if row.is_success, do: "✔", else: ""}</td>
            <td>{row.error_msg}</td>
          </tr>
        <% end %>
      </table>
    </div>
  <% end %>
</div>
<div class="pt-48"></div>
