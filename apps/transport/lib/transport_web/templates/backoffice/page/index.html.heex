<section class="container pt-48 pb-48">
  <h1>Backoffice</h1>
  <h2>Outils d'observation</h2>

  <% # See path explanation at https://elixirforum.com/t/scoped-live-view-does-not-seem-to-generate-a-live-path-helper/31162/4?u=thbar %>
  <.link class="button" href={~p"/backoffice/proxy-config"}>
    {dgettext("backoffice", "Proxy configuration")}
  </.link>

  <.link class="button" href={~p"/backoffice/jobs"}>
    {dgettext("backoffice", "Jobs")}
  </.link>

  <.link class="button" href={~p"/backoffice/dashboard"}>
    {dgettext("backoffice", "Rapport de complétude des imports")}
  </.link>

  <.link class="button" href={~p"/backoffice/broken-urls"}>
    {dgettext("backoffice", "Changements d'URLs stables")}
  </.link>

  <.link class="button" href={~p"/backoffice/cache"}>
    {dgettext("backoffice", "Cache debug")}
  </.link>

  <.link class="button" href={~p"/backoffice/rate_limiter"}>
    {dgettext("backoffice", "Rate limiter")}
  </.link>

  <.link class="button" href={~p"/backoffice/batch-report"}>
    {dgettext("backoffice", "GTFS data import")}
  </.link>

  <.link class="button" href={~p"/backoffice/phoenix-dashboard"}>
    {dgettext("backoffice", "Phoenix LiveDashboard")}
  </.link>

  <.link class="button" href={~p"/aoms"}>
    {dgettext("backoffice", "AOM open data status")}
  </.link>

  <.link class="button" href={~p"/backoffice/irve-dashboard"}>
    {dgettext("backoffice", "IRVE dashboard")}
  </.link>

  <.link class="button" href={~p"/backoffice/email_preview"}>
    {dgettext("backoffice", "Email preview")}
  </.link>
  <h2>Actions</h2>

  <.link class="button" href={~p"/backoffice/datasets/new"}>
    <i class="fas fa-plus"></i> {dgettext("backoffice", "Add a dataset")}
  </.link>
  <div class="import-all">
    <.form for={%{}} action={backoffice_dataset_path(@conn, :import_validate_all)} method="post">
      <.button>{dgettext("backoffice", "Import all datasets from data.gouv")}</.button>
    </.form>
  </div>
  <div>
    <.link
      class="button warning-light"
      href={~p"/backoffice/breaking_news"}
      title="Afficher un message sur la home du site"
    >
      Publier une Breaking News
    </.link>
  </div>
  <div>
    <.link class="button" href={~p"/backoffice/contacts"} title="Gérer les contacts">
      👥 Gestion des contacts
    </.link>
  </div>

  <h2>Exports</h2>
  <div>
    <.link
      class="button"
      href={
        ~p"/backoffice/download_datasets_csv?#{%{"export_key" => Application.fetch_env!(:transport, :export_secret_key)}}"
      }
      title="Export CSV des jeux de données"
    >
      📦 Export des jeux de données
    </.link>
    <.link
      class="button"
      href={
        ~p"/backoffice/download_resources_csv?#{%{"export_key" => Application.fetch_env!(:transport, :export_secret_key)}}"
      }
      title="Export CSV des ressources"
    >
      🗳 Export des ressources
    </.link>
    <.link class="button" href={~p"/backoffice/gtfs-export"} title="Export CSV des GTFS">
      🚏 Export des arrêts GTFS
    </.link>
    <.link class="button" href={~p"/backoffice/contacts/csv_export"} title="Export CSV des contacts">
      📓 Export des contacts
    </.link>
  </div>

  <h2>Consolidation BNLC</h2>
  <div>
    {live_render(@conn, TransportWeb.Live.SendConsolidateJobView,
      session: %{
        "button_texts" => %{
          sent: "Rapport disponible par e-mail",
          dispatched: "Consolidation en cours",
          default: "🧪 Consolider à blanc"
        },
        "button_default_class" => "button",
        "job_module" => Transport.Jobs.ConsolidateBNLCJob,
        "job_args" => %{}
      }
    )}
  </div>
  <div>
    {live_render(@conn, TransportWeb.Live.SendConsolidateJobView,
      session: %{
        "button_texts" => %{
          sent: "Fichier mis à jour et rapport envoyé",
          dispatched: "Consolidation en cours",
          default: "📥 Consolider et remplacer sur data.gouv.fr"
        },
        "button_default_class" => "button warning-light",
        "job_module" => Transport.Jobs.ConsolidateBNLCJob,
        "job_args" => %{"action" => "datagouv_update"}
      }
    )}
  </div>

  <h2>Consolidation ZFE</h2>
  <div>
    {live_render(@conn, TransportWeb.Live.SendConsolidateJobView,
      session: %{
        "button_texts" => %{
          sent: "Fichiers mis à jour",
          dispatched: "Consolidation en cours",
          default: "📥 Consolider et remplacer sur data.gouv.fr"
        },
        "button_default_class" => "button warning-light",
        "job_module" => Transport.Jobs.ConsolidateLEZsJob,
        "job_args" => %{}
      }
    )}
  </div>

  <h2>{dgettext("backoffice", "Validations")}</h2>
  <div>
    <.form for={%{}} action={backoffice_dataset_path(@conn, :force_validate_gtfs_transport)} class="no-margin">
      <div class="form__group">
        <.button>{dgettext("backoffice", "GTFS Transport validator - Force validation")}</.button>
      </div>
    </.form>
  </div>

  <h1 class="pt-48">
    <.link id="list_datasets" href="#list_datasets" class="anchor sr-only"></.link>
    {dgettext("backoffice", "Valid datasets available")}
  </h1>

  <.form
    :let={f}
    for={@search_form}
    action={"#{backoffice_page_path(@conn, :index)}#list_datasets"}
    id="backoffice_search_container"
    method="get"
  >
    <div class="search-filter-toolbar">
      <div class="search-section">
        <.input
          field={f[:q]}
          type="search"
          id="backoffice_search"
          placeholder={dgettext("page-index", "Find dataset")}
        />
        <button type="submit" class="button backoffice_search_button"><i class="fa fa-search"></i></button>
      </div>
      <div class="filter-section">
        <.link
          :for={filter <- dataset_filters()}
          href={"#{~p"/backoffice?#{Map.put(@conn.params, "filter", filter.key)}"}#list_datasets"}
          class={"filter-pill #{if @conn.params["filter"] == filter.key, do: "active"}"}
        >
          {filter.label}
        </.link>
        <%= if @conn.params["filter"] do %>
          <input type="hidden" name="filter" value={@conn.params["filter"]} />
          <.link
            href={"#{~p"/backoffice"}#list_datasets"}
            title={dgettext("backoffice", "Clear filter")}
            class="filter-clear"
          >
            <i class="fas fa-times"></i>
          </.link>
        <% end %>
      </div>
    </div>
  </.form>

  <div id="backoffice-datasets-table">
    <.pagination conn={@conn} page={@datasets} anchor="list_datasets" />
  </div>
  <table class="backoffice-results">
    <colgroup>
      <col class="dataset" />
      <col class="organisation" />
      <col class="end_date" />
      <col class="actions" />
    </colgroup>
    <thead>
      <tr>
        <th class="sortable">
          <.sort_link conn={@conn} field={:custom_title} order_by={@order_by}>Dataset</.sort_link>
        </th>
        <th class="sortable">
          <.sort_link conn={@conn} field={:organization} order_by={@order_by}>Organisation</.sort_link>
        </th>
        <th class="sortable">
          <.sort_link conn={@conn} field={:end_date} order_by={@order_by}>Fin de validité</.sort_link>
        </th>
        <th class="bo_action_button"></th>
      </tr>
    </thead>
    <tbody>
      <%= for dataset <- @datasets do %>
        {render(TransportWeb.Backoffice.PageView, "_dataset.html",
          dataset: dataset,
          end_date: Map.get(@end_dates, dataset.id),
          conn: @conn
        )}
      <% end %>
    </tbody>
  </table>
  <div class="pt-48">
    <.pagination conn={@conn} page={@datasets} anchor="list_datasets" />
  </div>
</section>
