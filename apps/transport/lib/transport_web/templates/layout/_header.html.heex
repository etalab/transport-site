<header class="navbar">
  <div class="navbar__container">
    <.link href={~p"/"} class="navbar__home">
      {img_tag("/images/logo-ministere-transports-2026-03.png",
        alt: gettext("transport.data.gouv.fr"),
        class: "navbar__logo-mariane"
      )}
      {img_tag("/images/logo-black.svg", alt: gettext("transport.data.gouv.fr"), class: "navbar__logo-black")}
    </.link>
    <nav>
      <.link href="#menu" class="nav__hamburger" aria-label={dgettext("page-index", "Open the menu")}>
        <i class="fa fa-bars"></i>
      </.link>
      <div id="menu">
        <.link id="close-menu" href="#" aria-label={dgettext("page-index", "Close the menu")}>
          <i class="fas icon--times-circle"></i>&nbsp
        </.link>
        <ul class="nav__links top-nav-links">
          <li class="nav__item">
            <button type="button" class="dropdown">
              {gettext("Data")}
              <div class="dropdown-content">
                <.link href={~p"/datasets"}>{gettext("Datasets")}</.link>
                <.link href={~p"/explore"}>{gettext("Data exploration map")}</.link>
                <.link href={~p"/explore/gtfs-stops"}>{gettext("National GTFS stops map")}</.link>
                <.link href={~p"/reuses"}>{gettext("Reuses")}</.link>
              </div>
            </button>
          </li>
          <li class="nav__item">
            <.link href="https://doc.transport.data.gouv.fr">{gettext("Documentation")}</.link>
          </li>
          <li class="nav__item">
            <button type="button" class="dropdown">
              {gettext("Tools")}
              <div class="dropdown-content">
                <.link href={~p"/validation"}>{gettext("Check the quality of a file or a feed")}</.link>
                <.link href={~p"/tools/gtfs_diff"}>{gettext("Compare two GTFS files")}</.link>
                <.link href={~p"/tools/siri-querier"}>{gettext("SIRI query generator")}</.link>

                <.link href="https://mtes-mct.github.io/alm-docs/" target="_blank">
                  {gettext("Accèslibre Mobilités")}
                </.link>
                <.link href="https://status.transport.data.gouv.fr" target="_blank">{gettext("Service status")}</.link>
              </div>
            </button>
          </li>
          <li class="nav__item">
            <.link href={~p"/stats"}>{gettext("Statistics")}</.link>
          </li>
          <li class="nav__item">
            <button type="button" class="dropdown">
              {gettext("Regulation")}
              <div class="dropdown-content">
                <.link href="https://normes.transport.data.gouv.fr" target="_blank">{gettext("Standards")}</.link>
                <.link
                  href="https://doc.transport.data.gouv.fr/presentation-et-mode-demploi-du-pan/declaration-de-conformite"
                  target="_blank"
                >
                  {gettext("Declaration of conformity")}
                </.link>
              </div>
            </button>
          </li>
          <li class="nav__item">
            <button type="button" class="dropdown">
              {gettext("About")}
              <div class="dropdown-content">
                <.link href={~p"/missions"}>{gettext("Our missions")}</.link>
                <.link href={~p"/nouveautes"}>{gettext("New features")}</.link>
              </div>
            </button>
          </li>
          <li class="nav__item">
            <.link href="https://blog.transport.data.gouv.fr">{gettext("Blog")}</.link>
          </li>
          <%= if assigns[:current_user] do %>
            <li class="nav__item">
              <button type="button" class="dropdown">
                <div class="user-name-display">
                  <img :if={avatar_url(@conn)} src={avatar_url(@conn)} alt="Avatar" class="nav__avatar" />
                  <span class="nav__username">
                    <%= if assigns[:current_user]["first_name"] && assigns[:current_user]["last_name"] do %>
                      {assigns[:current_user]["first_name"]} {assigns[:current_user]["last_name"]}
                    <% else %>
                      {gettext("My account")}
                    <% end %>
                  </span>
                  <% notifications_count = notifications_count(@conn) %>
                  <.notification_count count={notifications_count} static={true} />
                </div>
                <div class="dropdown-content">
                  <%= if TransportWeb.Session.admin?(@conn) do %>
                    <.link href={~p"/backoffice"}>Administration</.link>
                  <% end %>
                  <%= if TransportWeb.Session.producer?(@conn) do %>
                    <.link
                      class="with-badge"
                      data-link-name="producer-space"
                      href={~p"/espace_producteur?#{[utm_campaign: "menu_dropdown"]}"}
                    >
                      {gettext("Producer space")}
                      <.notification_count count={producer_notifications_count(@conn)} static={true} />
                    </.link>
                  <% end %>
                  <.link
                    class="with-badge"
                    data-link-name="reuser-space"
                    href={~p"/espace_reutilisateur?#{[utm_campaign: "menu_dropdown"]}"}
                  >
                    {gettext("Reuser space")}
                    <.notification_count count={reuser_notifications_count(@conn)} static={true} />
                  </.link>
                  <.link
                    class="navigation__link nagivation__link--logout"
                    href={~p"/logout?#{[redirect_path: current_path(@conn)]}"}
                  >
                    <i class="icon icon--logout" aria-hidden="true"></i>
                    <span>{gettext("Sign Out")}</span>
                  </.link>
                </div>
              </button>
            </li>
          <% else %>
            <li class="nav__item">
              <.link
                class="navigation__link navigation__link--login"
                href={~p"/login/explanation?#{[redirect_path: current_path(@conn)]}"}
              >
                <i class="icon icon--login" aria-hidden="true"></i>
                <span>{gettext("Sign In")}</span>
              </.link>
            </li>
          <% end %>
          <li class="nav__item">
            <button type="button" class="dropdown">
              <%= if get_session(@conn, :locale) == "fr" do %>
                <img src={static_path(@conn, "/images/icons/fr.png")} alt="Français" height="18px" />
              <% else %>
                <img src={static_path(@conn, "/images/icons/en.png")} alt="English" height="18px" />
              <% end %>
              <div class="dropdown-content languages">
                <.link href={add_locale_to_url(@conn, "fr")}>Français</.link>
                <.link href={add_locale_to_url(@conn, "en")}>English</.link>
              </div>
            </button>
          </li>
        </ul>
      </div>
    </nav>
  </div>
</header>
