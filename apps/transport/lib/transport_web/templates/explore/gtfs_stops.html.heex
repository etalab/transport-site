<div class="container dataset-page-top">
  <h2>{@page_title}</h2>
  <p>
    {raw(
      dgettext("explore", "Consolidated GTFS stops map explanation",
        github_issue_link: ~s(<a href="https://github.com/etalab/transport-site/issues/3167">#3167</a>),
        gtfs_stops_dataset_path: ~p"/datasets/arrets-de-transport-en-france",
        swagger_doc_path: "/swaggerui#/gtfs/API.GTFSStopsController.index"
      )
    )}
  </p>

  <div class="form__group">
    <%= form_for @conn, ~p"/explore/gtfs-stops", [method: "get"], fn f -> %>
      <div class="searchBar">
        {search_input(f, :q,
          id: "autoComplete",
          class: "no_legend",
          autocomplete: "off",
          placeholder: dgettext("explore", "Search a city"),
          "aria-label": dgettext("explore", "Search a city")
        )}
        <div class="autoCompleteResultsField">
          <div id="autoCompleteResults"></div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div id="map" class="explore_map"></div>

<section class="section section-white">
  {live_render(@conn, TransportWeb.Live.FeedbackLive, session: %{"feature" => "gtfs_stops"})}
</section>

<script src={~p"/js/gtfs.js"}>
</script>
<script src={~p"/js/autocomplete_address.js"}>
</script>
