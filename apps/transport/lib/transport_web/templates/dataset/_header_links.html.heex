<div data-section="dataset-header-links">
  <%= if TransportWeb.Session.admin?(@conn) do %>
    <i class="fa fa-up-right-from-square"></i>
    <.link href={~p"/backoffice/datasets/#{@dataset.id}/edit"}>Backoffice</.link> &middot;
  <% end %>
  <i class="fa fa-up-right-from-square"></i>
  <%= if @current_user do %>
    <%= if @is_producer do %>
      <.link
        href={~p"/espace_producteur/datasets/#{@dataset.id}/edit?#{[utm_campaign: "dataset_details"]}"}
        target="_blank"
      >
        {dgettext("default", "Producer space")}
      </.link>
    <% else %>
      <%= if @follows_dataset do %>
        <.link
          href={~p"/espace_reutilisateur/datasets/#{@dataset.id}?#{[utm_campaign: "dataset_details"]}"}
          target="_blank"
        >
          {dgettext("default", "Reuser space")}
        </.link>
      <% else %>
        <.link href={~p"/espace_reutilisateur?#{[utm_campaign: "dataset_details"]}"} target="_blank">
          {dgettext("default", "Reuser space")}
        </.link>
      <% end %>
    <% end %>
  <% else %>
    <.link href={~p"/infos_reutilisateurs?#{[utm_campaign: "dataset_details"]}"} target="_blank">
      {dgettext("default", "Reuser space")}
    </.link>
  <% end %>
</div>
