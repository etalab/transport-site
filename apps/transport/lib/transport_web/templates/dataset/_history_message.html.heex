<%= if @count_history_resources > 0 do %>
  <section class="dataset__resources">
    <p class="information-message">
      {raw(
        dgettext(
          "page-dataset-details",
          ~s(Past versions of the dataset resources are available in the <a href="%{url}">Backed up resources</a> section.),
          url: "#backed-up-resources"
        )
      )}
    </p>
  </section>
<% end %>
