<.form
  :let={f}
  for={@form_params}
  as={:form}
  action={@form_url}
  phx-change="change_dataset"
  phx-submit="save"
  phx-trigger-action={@trigger_submit}
  onkeydown="return event.key != 'Enter';"
  class="backoffice-form"
>
  <h1>
    <%= if is_nil(@dataset) do %>
      {dgettext("backoffice", "Add a dataset")}
    <% else %>
      {dgettext("backoffice", "Edit a dataset")}
    <% end %>
  </h1>
  <%= unless is_nil(@dataset) do %>
    <div class="pb-24">
      <i class="fa fa-up-right-from-square"></i>
      <.link href={dataset_path(@socket, :details, @dataset.id)}>
        {dgettext("backoffice", "See dataset on website")}
      </.link>
    </div>
  <% end %>

  <p :if={not is_nil(@dataset) and not @dataset.is_active} class="notification warning">
    Ce jeu de données a été supprimé de data.gouv.fr. Il faudrait probablement remplacer son URL source ou le déréférencer.
  </p>

  <div class="pt-24">
    <.input field={f[:url]} placeholder={dgettext("backoffice", "Dataset's url")} />

    <%= if @datagouv_infos do %>
      <div class="pt-12 pb-12">
        <%= if is_nil(@datagouv_infos[:dataset_datagouv_id]) do %>
          Impossible de trouver ce jeu de données sur data.gouv
        <% else %>
          <div>Jeu de données <strong>"{@datagouv_infos[:datagouv_title]}"</strong></div>
          <div class="pt-12">
            Son identifiant data.gouv est <code>{@datagouv_infos[:dataset_datagouv_id]}</code>
          </div>
          <div class="pt-12">
            <%= if @datagouv_infos[:dataset_id] do %>
              ⚠️ Ce jeu de données est déjà référencé <.link
                href={backoffice_page_path(@socket, :edit, @datagouv_infos[:dataset_id])}
                target="_blank"
              >sur le PAN</.link>, il n'est pas possible de le référencer une seconde fois.
            <% else %>
              Ce jeu n'est pas encore référencé chez nous ✅
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
    <.input field={f[:custom_title]} placeholder={dgettext("backoffice", "name")} label="Titre" />
    <.input
      field={f[:type]}
      type="select"
      options={@dataset_types}
      value={f[:type].value || if(is_nil(@dataset), do: "public-transit", else: @dataset.type)}
      label="Type"
    />
  </div>

  <.live_component
    module={TransportWeb.DatasetSubtypeLive}
    id="dataset_subtypes"
    form={f}
    dataset_subtypes={@dataset_subtypes}
    form_params={@form_params}
  />
  <.live_component module={TransportWeb.CustomTagsLive} id="custom_tags" form={f} custom_tags={@custom_tags} />

  <p :if={not is_nil(@dataset) and @dataset.is_hidden} class="notification">
    Ce jeu de données est masqué
  </p>

  <div :if={@dataset_organization} class="panel mt-48">
    <div class="panel-explanation">
      {dgettext("backoffice", "published by")}
    </div>
    <h4>{@dataset_organization}</h4>
    <.input
      field={f[:organization_type]}
      type="select"
      options={@organization_types}
      value={f[:organization_type].value || if(not is_nil(@dataset), do: @dataset.organization_type)}
      required
      prompt={dgettext("backoffice", "Publisher type")}
      wrapper={false}
    />
  </div>

  <div class="panel mt-48">
    <div class="panel-explanation">
      {dgettext("backoffice", "Offers")}
    </div>
    <.live_component module={TransportWeb.OfferSelectLive} id="offers_selection" form={f} offers={@offers} />
  </div>

  <div class="panel mt-48">
    <div class="panel-explanation">
      {dgettext("backoffice", "Legal owners")}
    </div>
    <.live_component
      module={TransportWeb.LegalOwnerSelectLive}
      id="owners_selection"
      form={f}
      owners={@legal_owners}
      offers={@offers}
    />
    <div class="pt-12">{dgettext("backoffice", "or")}</div>
    <div class="pt-12">
      <.input
        field={f[:legal_owner_company_siren]}
        placeholder="821611431"
        pattern="\d{9,9}"
        label={dgettext("backoffice", "Company SIREN code")}
      >
        <:help :if={@company}>{@company.nom_complet}</:help>
      </.input>
    </div>
  </div>

  <div class="panel mt-48">
    <div class="panel__header">
      <h4>
        {dgettext("backoffice", "Spatial area")}
      </h4>
    </div>
    <.live_component
      module={TransportWeb.DeclarativeSpatialAreasLive}
      id="declarative_spatial_areas"
      form={f}
      declarative_spatial_areas={@declarative_spatial_areas}
      nonce={@nonce}
    />
  </div>

  <div id="backoffice_dataset_submit_buttons" class={if is_nil(@dataset), do: "pb-48"}>
    <div>
      <%= if is_nil(@dataset) do %>
        <.input field={f[:action]} type="hidden" value="new" />
        <.button>{dgettext("backoffice", "Add")}</.button>
      <% else %>
        <.input field={f[:action]} type="hidden" value="edit" />
        <.button>{dgettext("backoffice", "Save")}</.button>
      <% end %>
    </div>
    <div>
      <.link href={backoffice_page_path(@socket, :index)}>{dgettext("backoffice", "Cancel")}</.link>
    </div>
  </div>
</.form>
